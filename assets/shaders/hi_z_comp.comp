#version 460 core

// ── Hi-Z Depth Pyramid Generation ──
// 将全分辨率深度图逐级降采样，生成 Hi-Z 深度金字塔。
// 每级取上一级 2x2 区域的 MAX 深度值（最远值）。
// 用于遮挡剔除测试。

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, r32f) readonly uniform image2D u_InputDepth;
layout(binding = 1, r32f) writeonly uniform image2D u_OutputDepth;

uniform int u_InputLevel;
uniform int u_OutputLevel;
uniform ivec2 u_OutputSize;

float Reduce2x2Max(ivec2 baseCoord, int level) {
    float d00 = imageLoad(u_InputDepth, baseCoord * 2 + ivec2(0,0)).r;
    float d01 = imageLoad(u_InputDepth, baseCoord * 2 + ivec2(1,0)).r;
    float d10 = imageLoad(u_InputDepth, baseCoord * 2 + ivec2(0,1)).r;
    float d11 = imageLoad(u_InputDepth, baseCoord * 2 + ivec2(1,1)).r;
    // Reverse-Z: far=0.0, near=1.0
    // MIN gives farthest depth for occlusion test (smallest = farthest)
    return min(min(d00, d01), min(d10, d11));
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= u_OutputSize.x || pix.y >= u_OutputSize.y) return;

    float depth = Reduce2x2Max(pix, u_InputLevel);
    imageStore(u_OutputDepth, pix, vec4(depth, 0.0, 0.0, 0.0));
}