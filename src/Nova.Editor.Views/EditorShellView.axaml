<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nova="using:Nova.UI.Controls"
             x:Class="Nova.Editor.Views.EditorShellView"
             x:CompileBindings="False">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding AddNodeCommand}" />
    <KeyBinding Gesture="Delete" Command="{Binding DeleteNodeCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+T" Command="{Binding ToggleThemeCommand}" />
  </UserControl.KeyBindings>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Save Layout" Command="{Binding SaveLayoutCommand}" />
        <MenuItem Header="_Reset Layout" Click="OnResetLayout" />
        <Separator />
        <MenuItem Header="_Close Project" Command="{Binding CloseProjectCommand}" />
        <MenuItem Header="E_xit" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" Command="{Binding UndoCommand}" />
        <MenuItem Header="_Redo" Command="{Binding RedoCommand}" />
        <Separator />
        <MenuItem x:Name="UndoLayoutMenuItem" Header="_Undo Layout" Command="{Binding UndoLayoutCommand}"
                  IsEnabled="{Binding CanUndoLayout}" />
        <MenuItem x:Name="RedoLayoutMenuItem" Header="_Redo Layout" Command="{Binding RedoLayoutCommand}"
                  IsEnabled="{Binding CanRedoLayout}" />
        <Separator />
        <MenuItem Header="Add _Entity" Command="{Binding AddNodeCommand}" />
        <MenuItem Header="_Delete Entity" Command="{Binding DeleteNodeCommand}" />
      </MenuItem>
      <MenuItem Header="_Scene">
        <MenuItem Header="Main Scene" Command="{Binding OpenMainSceneCommand}" />
        <MenuItem Header="Arena Only" Command="{Binding OpenArenaSceneCommand}" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Toggle _Theme" Command="{Binding ToggleThemeCommand}" />
        <Separator />
        <MenuItem x:Name="HiddenPanelsMenu" Header="_Hidden Panels" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="Nova UI v0.2 · Editor Foundation" IsEnabled="False" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top" Classes="nova-toolbar">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <nova:NovaButton Content="+ Entity" Command="{Binding AddNodeCommand}" Classes="nova-primary" />
        <nova:NovaButton Content="Delete" Command="{Binding DeleteNodeCommand}" />
        <Border Width="1" Height="18" Classes="nova-divider" Margin="4,0" />
        <nova:NovaButton Content="Undo" Command="{Binding UndoCommand}" />
        <nova:NovaButton Content="Redo" Command="{Binding RedoCommand}" />
        <Border Width="1" Height="18" Classes="nova-divider" Margin="4,0" />
        <nova:NovaButton x:Name="SaveLayoutButton" Content="Save Layout" Command="{Binding SaveLayoutCommand}" />
        <nova:NovaButton x:Name="ResetLayoutButton" Content="Reset Layout" Click="OnResetLayout" />
        <Border Width="1" Height="18" Classes="nova-divider" Margin="4,0" />
        <nova:NovaButton Content="Theme" Command="{Binding ToggleThemeCommand}" />
        <TextBlock Text="{Binding ActiveTheme}" Classes="nova-muted" VerticalAlignment="Center" Margin="6,0,0,0" />
        <Border Width="1" Height="18" Classes="nova-divider" Margin="4,0" />
        <TextBlock Text="{Binding SceneLabel}" Classes="nova-muted" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Classes="nova-toolbar">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <TextBlock x:Name="SaveStatusText" Text="{Binding StatusText}" />
          <TextBlock x:Name="StatusText" Text="Starting..." />
          <TextBlock x:Name="HierarchyCountText" Classes="nova-muted" />
          <TextBlock x:Name="DockDiagnosticText"
                     Classes="nova-muted"
                     IsVisible="False" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="Nova UI v0.2" Classes="nova-muted" />
      </Grid>
    </Border>

    <Grid Margin="4">
      <ContentControl x:Name="DockRoot" />
      <Border x:Name="DockDegradedBanner"
              Classes="nova-elevated"
              IsVisible="False"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="24"
              Padding="16"
              MaxWidth="560">
        <StackPanel Spacing="8">
          <TextBlock Text="Workspace layout unavailable" Classes="nova-title" />
          <TextBlock x:Name="DockDegradedText"
                     Classes="nova-secondary"
                     TextWrapping="Wrap" />
          <nova:NovaButton x:Name="DockRetryButton"
                           Content="Retry layout"
                           Click="OnRetryDockProjection"
                           HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
