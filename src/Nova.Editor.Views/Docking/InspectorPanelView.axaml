<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nova="using:Nova.UI.Controls"
             x:Class="Nova.Editor.Views.Docking.InspectorPanelView"
             x:CompileBindings="False">
  <Border Classes="nova-panel" Padding="8">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="2,0,2,8">
        <TextBlock x:Name="InspectorHeaderText" Text="Inspector" Classes="nova-title" />
        <TextBlock x:Name="InspectorTypeText" Text="" Classes="nova-secondary" FontSize="11" />
        <nova:NovaDivider Margin="0,6,0,0" />
      </StackPanel>

      <nova:NovaScrollArea>
        <ItemsControl ItemsSource="{Binding Properties}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <nova:NovaPropertyRow Label="{Binding Label}" Description="{Binding Description}">
                <nova:NovaPropertyRow.Value>
                  <Grid>
                    <nova:NovaNumberField IsVisible="{Binding IsNumber}"
                                          Value="{Binding NumberValue, Mode=TwoWay}"
                                          Minimum="{Binding Minimum}"
                                          Maximum="{Binding Maximum}"
                                          Step="{Binding Step}"
                                          Format="{Binding Format}" />
                    <nova:NovaTextField IsVisible="{Binding IsText}"
                                        Text="{Binding TextValue, Mode=OneWay}"
                                        TextCommitted="OnTextCommitted"
                                        Watermark="value" />
                    <CheckBox IsVisible="{Binding IsBool}"
                              IsChecked="{Binding BoolValue, Mode=TwoWay}"
                              Content="Enabled" />
                    <nova:NovaSelect IsVisible="{Binding IsChoice}"
                                     ItemsSource="{Binding Options}"
                                     SelectedItem="{Binding ChoiceValue, Mode=TwoWay}" />
                  </Grid>
                </nova:NovaPropertyRow.Value>
              </nova:NovaPropertyRow>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </nova:NovaScrollArea>
    </DockPanel>
  </Border>
</UserControl>
