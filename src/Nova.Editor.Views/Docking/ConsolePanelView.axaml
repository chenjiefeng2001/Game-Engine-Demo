<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nova="using:Nova.UI.Controls"
             x:Class="Nova.Editor.Views.Docking.ConsolePanelView"
             x:CompileBindings="False">
  <Border Classes="nova-panel" Padding="6">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="2,0,2,4">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Console" Classes="nova-section-title" />
          <TextBlock Text="{Binding ConsoleCount}" Classes="nova-muted" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
        <nova:NovaButton Grid.Column="1" Content="Clear" Command="{Binding ClearConsoleCommand}"
                         Classes="nova-subtle" />
      </Grid>
      <nova:NovaListView ItemsSource="{Binding Logs}" SelectionMode="Single">
        <nova:NovaListView.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Text}" Classes="nova-mono" TextWrapping="NoWrap" />
          </DataTemplate>
        </nova:NovaListView.ItemTemplate>
      </nova:NovaListView>
    </DockPanel>
  </Border>
</UserControl>
