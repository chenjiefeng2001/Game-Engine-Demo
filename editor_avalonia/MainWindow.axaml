<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaloniaEditor.MainWindow"
        Title="Avalonia Editor — Phase 1 Shell (P1-A/B/C)"
        Width="1100" Height="720"
        MinWidth="720" MinHeight="460">

  <DockPanel>
    <!-- Menu -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem x:Name="FileOpenItem" Header="_Open Project" Click="OnOpenProject"/>
        <MenuItem x:Name="FileSaveItem" Header="_Save Project" Click="OnSaveProject"/>
        <MenuItem x:Name="FileCloseItem" Header="_Close" Click="OnCloseProject"/>
      </MenuItem>
    </Menu>

    <!-- Toolbar (transport + P3-D Play/Reload/Stop Runtime) -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="6,4">
      <Button x:Name="OpenProjectBtn" Content="Open" Click="OnOpenProject"/>
      <Button x:Name="SaveProjectBtn" Content="Save" Click="OnSaveProject"/>
      <Button x:Name="ToolbarCreateEntityBtn" Content="+ Entity" Click="OnCreateEntity"/>
      <Button x:Name="PlayBtn" Content="Play" Click="OnPlay"/>
      <Button x:Name="ReloadBtn" Content="Reload Script" Click="OnReloadScript"
              IsEnabled="{Binding IsRunning}"/>
      <Button x:Name="StopBtn" Content="Stop" Click="OnStop"
              IsEnabled="{Binding IsRunning}"/>
      <TextBlock Text="[P3-D] Save → Play → Edit → Reload (保留 _PERSIST) → Stop"
                 VerticalAlignment="Center" Opacity="0.55" Margin="12,0,0,0"/>
    </StackPanel>

    <!-- StatusBar -->
    <Border DockPanel.Dock="Bottom" Background="#22000000" Padding="8,4">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock x:Name="StatusBar" Text="no project loaded"/>
        <TextBlock x:Name="DirtyBadge" Text="● DIRTY" Foreground="#FFD060"
                   IsVisible="False" FontWeight="Bold" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- 四区 Shell：左 Hierarchy / 中 Viewport / 右 Inspector / 下 Console+Assets

         列 240 | 8 | * | 8 | 280 —— 第 1/3 列是分隔条所在（原先是纯间隙，
         不可拖动，用户无法调整左右面板宽度）。
         行 * | 8 | 220 —— 第 1 行是横向分隔条。
         最小宽高写在各轴定义上而非只写 Window 级：即使将来有人调小窗口，
         各区也不会被压到 0 而丢内容。 -->
    <Grid Margin="4" NotARealAvaloniaProperty="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" MinWidth="180"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*" MinWidth="200"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="280" MinWidth="220"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="160"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="220" MinHeight="120"/>
      </Grid.RowDefinitions>

      <!-- 左：Hierarchy（P2-C2：Rename/Delete/Create 回路）-->
      <Border Grid.Column="0" Grid.RowSpan="3" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="4">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Hierarchy" FontWeight="Bold" Margin="2,2,0,6"/>
          <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,6,0,0">
            <TextBox x:Name="SearchBox" Text="{Binding SearchText, Mode=TwoWay}"
                     Watermark="search entities..."/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="RenameBox" Text="{Binding RenameInput, Mode=TwoWay}"
                       Watermark="new name..."/>
              <Button Grid.Column="1" x:Name="RenameEntityBtn" Content="Rename" Click="OnRenameEntity"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button x:Name="DeleteEntityBtn" Content="Delete" Click="OnDeleteEntity"/>
              <Button x:Name="HierarchyCreateEntityBtn" Content="+ Entity" Click="OnCreateEntity"/>
            </StackPanel>
          </StackPanel>
          <ListBox x:Name="HierarchyList"
                   ItemsSource="{Binding FilteredEntities}"
                   SelectedItem="{Binding SelectedEntity, Mode=OneWay}"
                   SelectionChanged="OnHierarchySelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- 中：Viewport（只占第 0 行）-->
      <Grid Grid.Column="2" Grid.Row="0">
        <Border BorderBrush="#33FFFFFF" BorderThickness="1" Background="#11000000">
          <!-- Viewport 占位：实际纹理互操作需要 NativeControlHost 或自定义渲染 -->
          <!-- Phase 7-A：纹理显示（FBO → Avalonia Image） -->
          <!-- Phase 7-B：输入转发（Pointer/Keyboard → Bridge ABI） -->
          <!-- Phase 7-C：Gizmo 工具栏 -->
          <Grid>
            <!-- 视口内容区 -->
            <Border Background="#1E1E1E" x:Name="ViewportBorder"
        PointerPressed="OnViewportPointerPressed"
                PointerReleased="OnViewportPointerReleased"
                PointerMoved="OnViewportPointerMoved"
                PointerWheelChanged="OnViewportPointerWheelChanged"
                KeyDown="OnViewportKeyDown"
                    KeyUp="OnViewportKeyUp"
                    Focusable="True">
              <Panel>
                <!-- Phase 7-A: Viewport 显示引擎 FBO 纹理。
                     Stretch 必须不是 None：当前呈现尺寸是固定的 800x600
                     （D4 resize 仍 Deferred，ViewportFramePresenter 注释
                     「固定 800x600；D4 Resize 仍 Deferred」），Stretch=None
                     会让控件小于图像时被裁掉一角、大于图像时图像贴左上角
                     留出空白 —— 两种都不是视口应有的行为。Uniform 等比缩放
                     并居中，宁可留黑边也不变形、不裁切。 -->
                <Image x:Name="ViewportImage" Stretch="Uniform"/>
                <!-- 占位文本（无纹理时显示） -->
                <TextBlock Text="VIEWPORT (Phase 7)" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Opacity="0.4" FontSize="20"
                           Name="ViewportPlaceholder"/>
              </Panel>
            </Border>

            <!-- Gizmo 工具栏（右上角叠加）-->
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="8"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
              <Button Content="Q" Width="28" Height="28" ToolTip.Tip="Select (Q)"
                      Click="OnGizmoSelect"/>
              <Button Content="W" Width="28" Height="28" ToolTip.Tip="Translate (W)"
                      Click="OnGizmoTranslate"/>
              <Button Content="E" Width="28" Height="28" ToolTip.Tip="Rotate (E)"
                      Click="OnGizmoRotate"/>
              <Button Content="R" Width="28" Height="28" ToolTip.Tip="Scale (R)"
                      Click="OnGizmoScale"/>
              <Separator Width="1" Background="#44FFFFFF" Margin="4,0"/>

              <!-- 坐标空间 World/Local。ABI（SetGizmoSpace）与 ViewModel 属性
                   本就存在，此前工具栏却没有对应控件，GizmoSpace 无从设置。
                   用静态字形 + ToolTip 表达状态，不引入转换器/资源：
                   未勾选=World，勾选=Local。与 ImGui 版工具栏同一做法
                   （那里是 m_GizmoLocal ? CUBE : DOT_CIRCLE）。 -->
              <ToggleButton Content="W/L" Width="40" Height="28"
                            IsChecked="{Binding GizmoSpaceLocal, Mode=TwoWay}"
                            ToolTip.Tip="Gizmo space — unchecked: World, checked: Local"/>

              <!-- 吸附开关 + 步长。步长绑 float 属性，Avalonia 原生支持
                   string↔float 双向转换；仅在吸附开启时可编辑。 -->
              <ToggleButton Content="S" Width="28" Height="28"
                            IsChecked="{Binding GizmoSnapEnabled, Mode=TwoWay}"
                            ToolTip.Tip="Snap to grid"/>
              <TextBox Width="54" Text="{Binding GizmoSnapValue, Mode=TwoWay}"
                       Watermark="snap"
                       IsEnabled="{Binding GizmoSnapEnabled, Mode=OneWay}"
                       VerticalAlignment="Center" ToolTip.Tip="Snap step"/>

              <Separator Width="1" Background="#44FFFFFF" Margin="4,0"/>
              <Button Content="G" Width="28" Height="28" ToolTip.Tip="Toggle Grid (G)"
                      Click="OnToggleGrid"/>
            </StackPanel>

            <!-- 视口叠加信息（左下角）。此前是硬编码的静态 "Viewport" 文本，
                 不随任何东西变化；现在绑定真实呈现帧的凭据。 -->
            <TextBlock Text="{Binding ViewportStatusText}" HorizontalAlignment="Left"
                       VerticalAlignment="Bottom" Margin="8,0,0,4"
                       Opacity="0.5" FontSize="11"/>
          </Grid>
        </Border>
      </Grid>

      <!-- 右：Inspector（只占第 0 行）-->
      <Border Grid.Column="4" Grid.Row="0" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="6">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Inspector" FontWeight="Bold" Margin="2,2,0,6"/>
          <StackPanel IsVisible="{Binding HasSelection}">
            <TextBlock Text="{Binding SelectedName}" FontWeight="SemiBold" Margin="2,0,0,6"/>
            <TextBlock Text="Sprite" Opacity="0.8" Margin="2,4,0,0"/>
            <TextBlock Text="{Binding SelectedSprite}" Margin="2,0,0,4" TextWrapping="Wrap"/>
            <TextBlock Text="Script" Opacity="0.8" Margin="2,4,0,0"/>
            <TextBlock Text="{Binding SelectedScript}" Margin="2,0,0,4" TextWrapping="Wrap"/>
            <TextBlock Text="Position"/>
            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="2">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center"/>
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PosX}" Margin="2"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" VerticalAlignment="Center"/>
              <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding PosY}" Margin="2"/>
              <TextBlock Grid.Row="2" Grid.Column="0" Text="Z" VerticalAlignment="Center"/>
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PosZ}" Margin="2"/>
            </Grid>
            <Button x:Name="ApplyTransformBtn" Content="Apply Transform" Click="OnApplyTransform" HorizontalAlignment="Left"/>

            <!-- 视口相机（编辑器视角，非所选实体的 Camera 组件）。
                 ABI 与 ViewModel 属性此前都已存在，但 Inspector 里没有任何可编辑面，
                 Gate 7-D 的「相机位置/缩放可编辑」「Perspective/Orthographic 切换」
                     因此无法在 UI 上完成。 -->
            <TextBlock Text="Viewport Camera" FontWeight="Bold" Margin="2,10,0,2"/>
            <Grid ColumnDefinitions="Auto,*" Margin="2">
              <TextBlock Grid.Column="0" Text="Pos X" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox Grid.Column="1" Text="{Binding ViewportCamX, Mode=TwoWay}"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*" Margin="2">
              <TextBlock Grid.Column="0" Text="Pos Y" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox Grid.Column="1" Text="{Binding ViewportCamY, Mode=TwoWay}"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*" Margin="2">
              <TextBlock Grid.Column="0" Text="Pos Z" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox Grid.Column="1" Text="{Binding ViewportCamZ, Mode=TwoWay}"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*" Margin="2">
              <TextBlock Grid.Column="0" Text="Zoom" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox Grid.Column="1" Text="{Binding ViewportZoom, Mode=TwoWay}"
                       Watermark="ortho zoom"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*" Margin="2">
              <TextBlock Grid.Column="0" Text="Projection" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <!-- ComboBox 的 SelectedIndex 与 ViewportProjection(int) 同型，
                   无需转换器。0=Perspective, 1=Orthographic -->
              <ComboBox Grid.Column="1" SelectedIndex="{Binding ViewportProjection, Mode=TwoWay}"
                        HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Perspective"/>
                <ComboBoxItem Content="Orthographic"/>
              </ComboBox>
            </Grid>

            <!-- F1 (Component Contract)：Camera Inspector（反射元数据驱动）-->
            <TextBlock Text="Camera" FontWeight="Bold" Margin="2,10,0,2"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button x:Name="AddCameraBtn" Content="+ Camera" Click="OnAddCamera"
                      IsEnabled="{Binding !HasCamera}"/>
              <Button x:Name="RemoveCameraBtn" Content="Remove Camera" Click="OnRemoveCamera"
                      IsEnabled="{Binding HasCamera}"/>
            </StackPanel>
            <StackPanel IsVisible="{Binding HasCamera}" Margin="2,6,0,0" Spacing="4">
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="Enabled" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding CameraEnabled}"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding CameraZoom}"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="Viewport" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding CameraViewport}"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="Bounds" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding CameraBounds}"/>
              </Grid>
              <Button x:Name="ApplyCameraBtn" Content="Apply Camera" Click="OnApplyCamera" HorizontalAlignment="Left"/>
            </StackPanel>
          </StackPanel>
          <TextBlock IsVisible="{Binding !HasSelection}" Text="(select an entity)"
                     Opacity="0.5"/>
        </DockPanel>
      </Border>

      <!-- 分隔条：Background=Transparent 让不可见的分隔条仍可命中指针，
           否则 Background 为空时 GridSplitter 收不到鼠标事件。
           ResizeBehavior=PreviousAndNext 表示同时调整相邻两列/两行，
           即左右面板相对中央区一起增减。 -->
      <GridSplitter Grid.Column="1" Grid.RowSpan="3"
                    Background="Transparent"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
      <GridSplitter Grid.Column="3" Grid.Row="0"
                    Background="Transparent"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
      <GridSplitter Grid.Column="2" Grid.ColumnSpan="3" Grid.Row="1"
                    Background="Transparent"
                    ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>

      <!-- 下：Console + Asset Browser Tab -->
      <TabControl x:Name="MainTabs" Grid.Column="2" Grid.ColumnSpan="3" Grid.Row="2">
        <TabItem Header="Console">
          <ListBox ItemsSource="{Binding ConsoleLines}"/>
        </TabItem>
        <TabItem Header="Asset Browser">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="4">
              <ComboBox ItemsSource="{Binding AssetTypeOptions}"
                        SelectedItem="{Binding AssetTypeFilter, Mode=TwoWay}"
                        Width="100"/>
              <TextBox Text="{Binding AssetSearchText, Mode=TwoWay}" Watermark="search assets"
                       Width="160"/>
              <Button x:Name="ImportAssetBtn" Content="Import..." Click="OnImportAsset"/>
              <Button x:Name="RenameAssetBtn" Content="Rename Selected" Click="OnRenameAsset"/>
              <TextBlock Text="{Binding FilteredAssetCount}" VerticalAlignment="Center" Opacity="0.7"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="4">
              <Button x:Name="AssignSpriteBtn" Content="Assign Sprite to Selected" Click="OnAssignSprite"/>
              <Button x:Name="AssignScriptBtn" Content="Assign Script to Selected" Click="OnAssignScript"/>
            </StackPanel>
            <ListBox x:Name="AssetList"
                     ItemsSource="{Binding FilteredAssets}"
                     SelectedItem="{Binding SelectedAsset, Mode=TwoWay}"
                     DoubleTapped="OnAssetDoubleTapped">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding TypeName}" Width="64" Opacity="0.7"/>
                    <TextBlock Text="{Binding Path}" Width="200" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Guid}" FontFamily="Consolas, Courier New"
                               FontSize="10" Opacity="0.5" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>
        <TabItem Header="Script Editor">
          <!-- D1 空态：无选中脚本时显示说明而非空白编辑框 -->
          <Panel>
            <StackPanel IsVisible="{Binding !HasScriptOpen}" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Spacing="8">
              <TextBlock Text="(no script open)" FontWeight="Bold"
                         HorizontalAlignment="Center" Opacity="0.7"/>
              <TextBlock Text="Double-click a .lua asset in the Asset Browser to open it."
                         Opacity="0.5" HorizontalAlignment="Center"/>
            </StackPanel>
            <DockPanel IsVisible="{Binding HasScriptOpen}">
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                <TextBlock Text="{Binding ScriptTitle}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBlock Text="(edited)" Foreground="#FFD060" IsVisible="{Binding ScriptDirty}"
                           VerticalAlignment="Center"/>
                <Button x:Name="SaveScriptBtn" Content="Save Script" Click="OnSaveScript" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding ScriptError}" Foreground="#FF8070" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="380"/>
              </StackPanel>
              <TextBox Text="{Binding ScriptText, Mode=TwoWay}"
                       AcceptsReturn="True" AcceptsTab="True"
                       FontFamily="Consolas, Courier New" FontSize="12"
                       TextChanged="OnScriptTextChanged"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
          </Panel>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
