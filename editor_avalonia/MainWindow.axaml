<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:auto="using:Avalonia.Automation"
        x:Class="AvaloniaEditor.MainWindow"
        Title="Avalonia Editor — Phase 1 Shell (P1-A/B/C)"
        Width="1100" Height="720" MinWidth="900" MinHeight="600"
        Background="{DynamicResource EditorCanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

  <DockPanel>
    <!-- Menu -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem x:Name="FileOpenItem" Header="_Open Project" Click="OnOpenProject"/>
        <MenuItem x:Name="FileSaveItem" Header="_Save Project" Click="OnSaveProject"/>
        <MenuItem x:Name="FileCloseItem" Header="_Close" Click="OnCloseProject"/>
      </MenuItem>
    </Menu>

    <!-- Toolbar：全局 / 编辑 / 运行三组；运行态由 badge 表达 -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8,6"
                Background="{DynamicResource PanelSurfaceBrush}">
      <StackPanel x:Name="ToolbarGlobalGroup" Orientation="Horizontal" Spacing="4">
        <Button x:Name="OpenProjectBtn" Content="Open" Click="OnOpenProject"
                ToolTip.Tip="Open a project"/>
        <Button x:Name="SaveProjectBtn" Content="Save" Click="OnSaveProject"
                auto:AutomationProperties.AutomationId="SaveProjectBtn"
                ToolTip.Tip="Save the current project"/>
      </StackPanel>

      <Border Width="1" Height="24" Background="{DynamicResource BorderSubtleBrush}" Margin="4,0"/>

      <StackPanel x:Name="ToolbarEditGroup" Orientation="Horizontal" Spacing="4">
        <Button x:Name="ToolbarCreateEntityBtn" Content="+ Entity" Click="OnCreateEntity"
                auto:AutomationProperties.AutomationId="ToolbarCreateEntityBtn"
                ToolTip.Tip="Create an entity"/>
        <Button x:Name="UndoSceneBtn" Content="Undo" Click="OnUndoScene"
                IsEnabled="{Binding CanUndoScene}"
                auto:AutomationProperties.AutomationId="UndoSceneBtn"/>
        <Button x:Name="RedoSceneBtn" Content="Redo" Click="OnRedoScene"
                IsEnabled="{Binding CanRedoScene}"
                auto:AutomationProperties.AutomationId="RedoSceneBtn"/>
        <ComboBox x:Name="RendererPathSelector" Width="120" SelectedIndex="0"
                  SelectionChanged="OnRendererPathChanged"
                  auto:AutomationProperties.AutomationId="ViewportRendererPathSelector">
          <ComboBoxItem Content="Direct" Tag="0"/>
          <ComboBoxItem Content="RenderGraph" Tag="1"/>
        </ComboBox>
        <TextBlock x:Name="RendererPathStatus" Text="Direct" VerticalAlignment="Center"
                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                   auto:AutomationProperties.AutomationId="RendererPathStatus"/>
      </StackPanel>

      <Border Width="1" Height="24" Background="{DynamicResource BorderSubtleBrush}" Margin="4,0"/>

      <StackPanel x:Name="ToolbarTransportGroup" Orientation="Horizontal" Spacing="4">
        <Button x:Name="PlayBtn" Content="Play" Click="OnPlay" Classes="primary"
                ToolTip.Tip="Play / Stop"/>
        <Button x:Name="ReloadBtn" Content="Reload Script" Click="OnReloadScript"
                IsEnabled="{Binding IsRunning}"
                ToolTip.Tip="Reload the active script"/>
        <Button x:Name="StopBtn" Content="Stop" Click="OnStop"
                IsEnabled="{Binding IsRunning}"
                ToolTip.Tip="Stop the runtime"/>
      </StackPanel>

      <Border x:Name="RunningBadge" IsVisible="{Binding IsRunning}"
              Background="{DynamicResource AccentBrush}" CornerRadius="3" Padding="8,3" Margin="4,0,0,0"
              VerticalAlignment="Center">
        <TextBlock Text="PLAYING" Foreground="{DynamicResource WhiteBrush}" FontSize="11" FontWeight="SemiBold"/>
      </Border>
    </StackPanel>

    <!-- StatusBar -->
    <Border x:Name="StatusBarSurface" DockPanel.Dock="Bottom"
            Background="{DynamicResource StatusBarBrush}" Padding="8,4">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock x:Name="StatusBar" Text="no project loaded"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBlock x:Name="RunningStatusBadge" Text="● RUNNING" Foreground="{DynamicResource AccentBrush}"
                   IsVisible="{Binding IsRunning}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock x:Name="DirtyBadge" Text="● DIRTY" Foreground="{DynamicResource WarningBrush}"
                   IsVisible="False" FontWeight="Bold" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- 四区 Shell：左 Hierarchy / 中 Viewport / 右 Inspector / 下 Console+Assets -->
    <Grid x:Name="MainGrid" Margin="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" MinWidth="200"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*" MinWidth="320"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="280" MinWidth="240"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="240"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="220" MinHeight="140" MaxHeight="360"/>
      </Grid.RowDefinitions>
      <!-- Hierarchy -->
      <Border Grid.Column="0" Grid.RowSpan="3"
              Background="{DynamicResource PanelSurfaceBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Hierarchy" FontWeight="Bold" Margin="4,2,0,8"/>
          <TextBlock DockPanel.Dock="Top" Text="{Binding PrefabReconciliationStatus}"
                     FontSize="10" Foreground="Orange" TextWrapping="Wrap" Margin="4,0,0,6"
                     auto:AutomationProperties.AutomationId="HierarchyPrefabStatus"/>
          <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,6,0,0">
            <TextBox x:Name="SearchBox" Text="{Binding SearchText, Mode=TwoWay}"
                     Watermark="search entities..."/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="RenameBox" Text="{Binding RenameInput, Mode=TwoWay}"
                       Watermark="new name..."/>
              <Button Grid.Column="1" x:Name="RenameEntityBtn" Content="Rename" Click="OnRenameEntity"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button x:Name="DeleteEntityBtn" Content="Delete" Click="OnDeleteEntity"
                      Classes="danger"/>
              <Button x:Name="HierarchyCreateEntityBtn" Content="+ Entity" Click="OnCreateEntity"/>
              <Button x:Name="HierarchyCreateChildBtn" Content="+ Child" Click="OnCreateChild"/>
              <Button x:Name="HierarchyOutdentBtn" Content="Outdent" Click="OnHierarchyOutdent"/>
              <Button x:Name="HierarchyDuplicateEntityBtn" Content="Duplicate" Click="OnDuplicateEntity"/>
              <Button x:Name="HierarchyDuplicateSubtreeBtn" Content="Dup Tree" Click="OnDuplicateSubtree"/>
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="PrefabNameBox" Text="{Binding PrefabNameInput, Mode=TwoWay}"
                       Watermark="prefab asset name..."
                       auto:AutomationProperties.AutomationId="PrefabNameBox"/>
              <Button Grid.Column="1" x:Name="CreatePrefabBtn" Content="Create Prefab"
                      Click="OnCreatePrefab"
                      auto:AutomationProperties.AutomationId="CreatePrefabBtn"/>
            </Grid>
            <TextBlock Text="target: assets/prefabs" Opacity="0.7"
                       auto:AutomationProperties.AutomationId="PrefabTargetPath"/>
            <TextBlock Text="{Binding PrefabDiagnostic}" Foreground="OrangeRed" TextWrapping="Wrap"
                       auto:AutomationProperties.AutomationId="PrefabDiagnostic"/>
            <ComboBox x:Name="ReparentModeBox"
                      SelectedIndex="{Binding ReparentModeIndex, Mode=TwoWay}"
                      ItemsSource="{Binding ReparentModes}" HorizontalAlignment="Stretch"/>
          </StackPanel>
          <Grid>
            <ListBox x:Name="HierarchyList" MinHeight="120" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                     auto:AutomationProperties.AutomationId="HierarchyList"
                     ItemsSource="{Binding HierarchyRows}"
                     SelectionChanged="OnHierarchySelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                    <Button Content="{Binding ExpandGlyph}" Width="18" Height="18" Padding="0"
                            Click="OnToggleHierarchyNode"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="HierarchyEmptyState" Text="(no entities)"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       IsVisible="{Binding !HasEntities}"/>
          </Grid>
        </DockPanel>
      </Border>

      <!-- 中：Viewport + Gizmo 工具栏 -->
      <Grid x:Name="ViewportHost" Grid.Column="2" Grid.Row="0">
        <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                Background="{DynamicResource EditorCanvasBrush}">
          <!-- Viewport 占位：实际纹理互操作需要 NativeControlHost 或自定义渲染 -->
          <!-- Phase 7-A：纹理显示（FBO → Avalonia Image） -->
          <!-- Phase 7-B：输入转发（Pointer/Keyboard → Bridge ABI） -->
          <!-- Phase 7-C：Gizmo 工具栏 -->
          <Grid>
            <!-- 视口内容区 -->
            <Border Background="{DynamicResource EditorCanvasBrush}" x:Name="ViewportBorder"
                    ClipToBounds="True"
                    PointerPressed="OnViewportPointerPressed"
                    PointerReleased="OnViewportPointerReleased"
                    PointerMoved="OnViewportPointerMoved"
                    PointerWheelChanged="OnViewportPointerWheelChanged"
                    KeyDown="OnViewportKeyDown"
                    KeyUp="OnViewportKeyUp"
                    Focusable="True">
              <Panel>
                <!-- Phase 7-A: Viewport 显示引擎 FBO 纹理 -->
                <!-- Slice D D-C1/D-C2：帧必须 **1:1 绘制在控件原点**。
                     Stretch=None + Left/Top 对齐使 `ViewportImage.Bounds` 等于帧尺寸，
                     因此 `e.GetPosition(ViewportImage)` 直接就是 canonical 像素坐标。
                     改回默认 Stretch 对齐会让该前提失效（ViewModel 的 mapper 会 fail-closed）。 -->
                <Image x:Name="ViewportImage" Stretch="None" auto:AutomationProperties.AutomationId="ViewportImage"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Canvas x:Name="GizmoCanvas" ClipToBounds="True" IsHitTestVisible="False"
                        IsVisible="False">
                  <Line x:Name="GizmoXLine" Stroke="#E5484D" StrokeThickness="3"
                        StartPoint="0,0" EndPoint="0,0"/>
                  <Line x:Name="GizmoYLine" Stroke="#3DD68C" StrokeThickness="3"
                        StartPoint="0,0" EndPoint="0,0"/>
                  <Line x:Name="GizmoZLine" Stroke="#4C8DFF" StrokeThickness="3"
                        StartPoint="0,0" EndPoint="0,0"/>
                  <Ellipse x:Name="GizmoOrigin" Width="8" Height="8" Fill="White"
                           Stroke="#202020" StrokeThickness="1"/>
                  <TextBlock x:Name="GizmoScreenHints" Opacity="0" FontSize="1"
                             IsHitTestVisible="False"
                             auto:AutomationProperties.AutomationId="GizmoScreenHints"/>
                </Canvas>
                <!-- 占位文本（无纹理时显示） -->
                <TextBlock Text="VIEWPORT (Phase 7)" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Opacity="0.4" FontSize="20"
                           Name="ViewportPlaceholder"/>
                <!-- B6: production presentation frame receipt (real FBO pixels). -->
                <TextBlock x:Name="ViewportFrameStats" Text="frame=0 nonClear=0"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           Margin="6" FontSize="10" Opacity="0.65"
                           IsHitTestVisible="False"
                           auto:AutomationProperties.AutomationId="ViewportFrameStats"/>
              </Panel>
            </Border>

            <!-- Gizmo 工具栏（右上角叠加） -->
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="8"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
              <Button x:Name="GizmoSelectBtn" Content="⌖" Classes="gizmo"
                      Width="28" Height="28" ToolTip.Tip="Select (Q)"
                      Click="OnGizmoSelect"/>
              <Button x:Name="GizmoTranslateBtn" Content="✥" Classes="gizmo"
                      Width="28" Height="28" ToolTip.Tip="Translate (W)"
                      Click="OnGizmoTranslate"/>
              <Button x:Name="GizmoRotateBtn" Content="⟳" Classes="gizmo"
                      Width="28" Height="28" ToolTip.Tip="Rotate (E)"
                      Click="OnGizmoRotate"/>
              <Button x:Name="GizmoScaleBtn" Content="⤢" Classes="gizmo"
                      Width="28" Height="28" ToolTip.Tip="Scale (R)"
                      Click="OnGizmoScale"/>
              <Separator Width="1" Background="{DynamicResource BorderSubtleBrush}" Margin="4,0"/>
              <Button x:Name="GizmoGridBtn" Content="▦" Classes="gizmo"
                      Width="28" Height="28" ToolTip.Tip="Toggle Grid (G)"
                      Click="OnToggleGrid"/>
            </StackPanel>

            <!-- 视口统计信息（左下角叠加） -->
            <TextBlock Text="Viewport" HorizontalAlignment="Left"
                       VerticalAlignment="Bottom" Margin="8,0,0,4"
                       Opacity="0.5" FontSize="11"/>
          </Grid>
        </Border>
      </Grid>

      <!-- 右：Inspector -->
      <Border x:Name="InspectorPanel" Grid.Column="4" Grid.Row="0"
              Background="{DynamicResource PanelSurfaceBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Inspector" FontWeight="Bold" Margin="4,2,0,8"/>
          <ScrollViewer x:Name="InspectorScroll"
                        auto:AutomationProperties.AutomationId="InspectorScroll"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
          <StackPanel IsVisible="{Binding HasSelection}">
            <TextBlock Text="{Binding SelectedName}" FontWeight="SemiBold" Margin="2,0,0,6"/>
            <StackPanel IsVisible="{Binding IsPrefabInstance}" Spacing="2" Margin="2,0,0,6">
              <TextBlock Text="Prefab Instance" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
              <TextBlock Text="{Binding PrefabInstanceStatus}" FontSize="11" TextWrapping="Wrap"
                         auto:AutomationProperties.AutomationId="PrefabInstanceStatus"/>
              <TextBlock Text="{Binding PrefabReconciliationStatus}" FontSize="11" TextWrapping="Wrap"
                         Foreground="Orange"
                         auto:AutomationProperties.AutomationId="PrefabReconciliationStatus"/>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="PreviewReconciliationBtn" Content="Preview Source"
                        Click="OnPreviewReconciliation"
                        IsEnabled="{Binding CanPreviewPrefabReconciliation}"
                        auto:AutomationProperties.AutomationId="PreviewReconciliationBtn"/>
                <Button x:Name="ApplyReconciliationBtn" Content="Apply Reconciliation"
                        Click="OnApplyReconciliation"
                        IsEnabled="{Binding CanApplyPrefabReconciliation}"
                        auto:AutomationProperties.AutomationId="ApplyReconciliationBtn"/>
              </StackPanel>
              <ListBox x:Name="PrefabConflictList" Height="64"
                        ItemsSource="{Binding PrefabConflicts}"
                        SelectedItem="{Binding SelectedPrefabConflict, Mode=TwoWay}"
                        auto:AutomationProperties.AutomationId="PrefabConflictList">
                <ListBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap"/></DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBox x:Name="PrefabManualConflictValue"
                       Text="{Binding PrefabManualConflictValue, Mode=TwoWay}"
                       Watermark="Manual value (JSON)"
                       auto:AutomationProperties.AutomationId="PrefabManualConflictValue"/>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="TakeSourceConflictBtn" Content="Take Source"
                        Click="OnTakeSourceConflict"
                        IsEnabled="{Binding CanResolvePrefabConflict}"
                        auto:AutomationProperties.AutomationId="TakeSourceConflictBtn"/>
                <Button x:Name="KeepLocalConflictBtn" Content="Keep Local"
                        Click="OnKeepLocalConflict"
                        IsEnabled="{Binding CanResolvePrefabConflict}"
                        auto:AutomationProperties.AutomationId="KeepLocalConflictBtn"/>
                <Button x:Name="ManualEditConflictBtn" Content="Manual Edit"
                        Click="OnManualEditConflict"
                        IsEnabled="{Binding CanResolvePrefabConflict}"
                        auto:AutomationProperties.AutomationId="ManualEditConflictBtn"/>
              </StackPanel>
              <TextBlock Text="{Binding PrefabOverrideFields}" FontSize="11" TextWrapping="Wrap"
                         Opacity="0.8"
                         auto:AutomationProperties.AutomationId="PrefabOverrideFields"/>
              <ComboBox x:Name="PrefabOverrideList"
                        ItemsSource="{Binding PrefabOverrides}"
                        SelectedItem="{Binding SelectedPrefabOverride, Mode=TwoWay}"
                        auto:AutomationProperties.AutomationId="PrefabOverrideList"/>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="RevertOverrideBtn" Content="Revert Field" Click="OnRevertPrefabOverride"
                        IsEnabled="{Binding CanRevertPrefabOverride}"
                        auto:AutomationProperties.AutomationId="RevertOverrideBtn"/>
                <Button x:Name="RevertInstanceBtn" Content="Revert Instance" Click="OnRevertPrefabInstance"
                        IsEnabled="{Binding CanRevertPrefabInstance}"
                        auto:AutomationProperties.AutomationId="RevertInstanceBtn"/>
                <Button x:Name="ApplyPrefabBtn" Content="Apply Overrides" Click="OnApplyPrefabOverrides"
                        IsEnabled="{Binding CanApplyPrefabOverrides}"
                        auto:AutomationProperties.AutomationId="ApplyPrefabBtn"/>
              </StackPanel>
            </StackPanel>
            <TextBlock Text="Sprite" Opacity="0.8" Margin="2,4,0,0"/>
            <TextBlock Text="{Binding SelectedSprite}" Margin="2,0,0,4" TextWrapping="Wrap"/>
            <TextBlock Text="Script" Opacity="0.8" Margin="2,4,0,0"/>
            <TextBlock Text="{Binding SelectedScript}" Margin="2,0,0,4" TextWrapping="Wrap"/>
            <TextBlock Text="Position"/>
            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="2">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center"/>
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PosX}" Margin="2" auto:AutomationProperties.AutomationId="PosX"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" VerticalAlignment="Center"/>
              <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding PosY}" Margin="2" auto:AutomationProperties.AutomationId="PosY"/>
              <TextBlock Grid.Row="2" Grid.Column="0" Text="Z" VerticalAlignment="Center"/>
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PosZ}" Margin="2" auto:AutomationProperties.AutomationId="PosZ"/>
            </Grid>
            <Button x:Name="ApplyTransformBtn" Content="Apply Transform" Click="OnApplyTransform" HorizontalAlignment="Left"
                    auto:AutomationProperties.AutomationId="ApplyTransformBtn"/>
            <TextBlock Text="Rotation (degrees)" Margin="2,6,0,0"/>
            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="2">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center"/>
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RotX}" Margin="2" auto:AutomationProperties.AutomationId="RotX"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" VerticalAlignment="Center"/>
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RotY}" Margin="2" auto:AutomationProperties.AutomationId="RotY"/>
              <TextBlock Grid.Row="2" Grid.Column="0" Text="Z" VerticalAlignment="Center"/>
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RotZ}" Margin="2" auto:AutomationProperties.AutomationId="RotZ"/>
            </Grid>
            <TextBlock Text="Scale" Margin="2,6,0,0"/>
            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="2">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center"/>
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ScaleX}" Margin="2" auto:AutomationProperties.AutomationId="ScaleX"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" VerticalAlignment="Center"/>
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ScaleY}" Margin="2" auto:AutomationProperties.AutomationId="ScaleY"/>
              <TextBlock Grid.Row="2" Grid.Column="0" Text="Z" VerticalAlignment="Center"/>
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ScaleZ}" Margin="2" auto:AutomationProperties.AutomationId="ScaleZ"/>
            </Grid>

            <!-- F1 (Component Contract)：Camera Inspector（反射元数据驱动）-->
            <TextBlock Text="Camera" FontWeight="Bold" Margin="4,12,0,4"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button x:Name="AddCameraBtn" Content="+ Camera" Click="OnAddCamera"
                      IsEnabled="{Binding !HasCamera}"/>
              <Button x:Name="RemoveCameraBtn" Content="Remove Camera" Click="OnRemoveCamera"
                      Classes="danger" IsEnabled="{Binding HasCamera}"/>
            </StackPanel>
            <StackPanel IsVisible="{Binding HasCamera}" Margin="4,8,0,0" Spacing="8">
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="Enabled" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding CameraEnabled}"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding CameraZoom}"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="Viewport" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding CameraViewport}"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="Bounds" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding CameraBounds}"/>
              </Grid>
              <Button x:Name="ApplyCameraBtn" Content="Apply Camera" Click="OnApplyCamera" HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- T-1-E：RigidBody Inspector（通用组件通道）-->
            <TextBlock Text="RigidBody" FontWeight="Bold" Margin="4,12,0,4"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button x:Name="AddRigidBodyBtn" Content="+ RigidBody" Click="OnAddRigidBody"
                      IsEnabled="{Binding !HasRigidBody}"/>
              <Button x:Name="RemoveRigidBodyBtn" Content="Remove RigidBody" Click="OnRemoveRigidBody"
                      Classes="danger" IsEnabled="{Binding HasRigidBody}"/>
            </StackPanel>
            <StackPanel IsVisible="{Binding HasRigidBody}" Margin="4,8,0,0" Spacing="8">
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="Motion Type" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding RigidBodyMotionTypes}"
                          SelectedItem="{Binding RigidBodyMotionType, Mode=TwoWay}"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="Linear Damping" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding RigidBodyLinearDamping}"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="Angular Damping" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding RigidBodyAngularDamping}"/>
              </Grid>
              <Button x:Name="ApplyRigidBodyBtn" Content="Apply RigidBody" Click="OnApplyRigidBody"
                      HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- B6: MeshComponent (read-only diagnostics) -->
            <StackPanel IsVisible="{Binding HasMesh}" Margin="4,12,0,0" Spacing="6">
              <TextBlock Text="Mesh" FontWeight="Bold"/>
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="Mesh Name" Width="120" Opacity="0.75"/>
                <TextBlock Grid.Column="1" Text="{Binding MeshName}"
                           auto:AutomationProperties.AutomationId="MeshNameValue"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="Mesh GUID" Width="120" Opacity="0.75"/>
                <TextBlock Grid.Column="1" Text="{Binding MeshGuid}"
                           FontFamily="Consolas, Courier New" FontSize="11"
                           auto:AutomationProperties.AutomationId="MeshGuidValue"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="Span Count" Width="120" Opacity="0.75"/>
                <TextBlock Grid.Column="1" Text="{Binding MeshSpanCount}"
                           auto:AutomationProperties.AutomationId="MeshSpanCountValue"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="Material Slots" Width="120" Opacity="0.75"/>
                <TextBlock Grid.Column="1" Text="{Binding MeshMaterialSlotCount}"
                           auto:AutomationProperties.AutomationId="MeshMaterialSlotCountValue"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="Load Status" Width="120" Opacity="0.75"/>
                <TextBlock Grid.Column="1" Text="{Binding MeshStatus}"
                           auto:AutomationProperties.AutomationId="MeshStatusValue"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="Error" Width="120" Opacity="0.75"/>
                <TextBlock Grid.Column="1" Text="{Binding MeshError}" TextWrapping="Wrap"
                           auto:AutomationProperties.AutomationId="MeshErrorValue"/>
              </Grid>
            </StackPanel>
          </StackPanel>
          <!-- P7-A: Material Inspector (asset selection) -->
          <StackPanel IsVisible="{Binding IsMaterialSelected}" Margin="4,12,0,0" Spacing="6">
            <TextBlock Text="Material" FontWeight="Bold"/>
            <TextBlock Text="{Binding MaterialAssetPath}" TextWrapping="Wrap" Opacity="0.75"
                       auto:AutomationProperties.AutomationId="MaterialAssetPathValue"/>
            <TextBlock Text="Base Color (R G B A)" Opacity="0.75"/>
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
              <TextBox Grid.Row="0" Grid.Column="0" Width="60" Text="{Binding MaterialBaseColorR}" Margin="2" auto:AutomationProperties.AutomationId="MaterialBaseColorR"/>
              <TextBox Grid.Row="0" Grid.Column="1" Width="60" Text="{Binding MaterialBaseColorG}" Margin="2" auto:AutomationProperties.AutomationId="MaterialBaseColorG"/>
              <TextBox Grid.Row="1" Grid.Column="0" Width="60" Text="{Binding MaterialBaseColorB}" Margin="2" auto:AutomationProperties.AutomationId="MaterialBaseColorB"/>
              <TextBox Grid.Row="1" Grid.Column="1" Width="60" Text="{Binding MaterialBaseColorA}" Margin="2" auto:AutomationProperties.AutomationId="MaterialBaseColorA"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="Metallic" Width="100" Opacity="0.75"/>
              <TextBox Grid.Column="1" Text="{Binding MaterialMetallic}" auto:AutomationProperties.AutomationId="MaterialMetallic"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="Roughness" Width="100" Opacity="0.75"/>
              <TextBox Grid.Column="1" Text="{Binding MaterialRoughness}" auto:AutomationProperties.AutomationId="MaterialRoughness"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="Emissive" Width="100" Opacity="0.75"/>
              <TextBox Grid.Column="1" Text="{Binding MaterialEmissive}" auto:AutomationProperties.AutomationId="MaterialEmissive"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="Alpha Cutoff" Width="100" Opacity="0.75"/>
              <TextBox Grid.Column="1" Text="{Binding MaterialAlphaCutoff}" auto:AutomationProperties.AutomationId="MaterialAlphaCutoff"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="Alpha Mode" Width="100" Opacity="0.75"/>
              <TextBox Grid.Column="1" Text="{Binding MaterialAlphaMode}" auto:AutomationProperties.AutomationId="MaterialAlphaMode"/>
            </Grid>
            <TextBlock Text="{Binding MaterialDiagnostic}" TextWrapping="Wrap" Foreground="OrangeRed"
                       auto:AutomationProperties.AutomationId="MaterialDiagnostic"/>
            <TextBlock Text="Note: only Base Color currently affects the production shader; metallic, roughness, emissive and alpha fields are stored but not rendered yet."
                       TextWrapping="Wrap" Opacity="0.7" FontSize="11"/>
            <Button x:Name="SaveMaterialBtn" Content="Save Material" Click="OnSaveMaterial"
                    HorizontalAlignment="Left"
                    auto:AutomationProperties.AutomationId="SaveMaterialBtn"/>
          </StackPanel>
          <TextBlock IsVisible="{Binding !HasSelection}" Text="(select an entity)"
                     Opacity="0.5"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- 下：Console + Asset Browser Tab -->
      <TabControl x:Name="MainTabs" Grid.Column="2" Grid.ColumnSpan="3" Grid.Row="2"
                  Background="{DynamicResource PanelSurfaceBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}">
        <TabItem Header="Console">
          <Border x:Name="ConsoleTabSurface"
                  Background="{DynamicResource PanelSurfaceBrush}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8,4">
              <TextBox x:Name="ConsoleFilterBox"
                       Text="{Binding ConsoleFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       Watermark="filter console"
                       Background="{DynamicResource InputSurfaceBrush}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       auto:AutomationProperties.AutomationId="ConsoleFilterBox"
                       Width="220"/>
              <Button x:Name="ConsoleClearBtn" Content="Clear"
                      Background="{DynamicResource InputSurfaceBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      auto:AutomationProperties.AutomationId="ConsoleClearBtn"
                      Click="OnClearConsole"/>
            </StackPanel>
            <Grid>
              <ListBox x:Name="ConsoleList" Classes="console"
                       auto:AutomationProperties.AutomationId="ConsoleList"
                       ItemsSource="{Binding ConsoleView}"/>
              <TextBlock x:Name="ConsoleEmptyState" Text="(console is empty)"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsHitTestVisible="False"
                         IsVisible="{Binding !HasConsoleLines}"/>
            </Grid>
          </DockPanel>
          </Border>
        </TabItem>
        <TabItem Header="Asset Browser">
          <Border x:Name="AssetTabSurface"
                  Background="{DynamicResource PanelSurfaceBrush}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8,4">
              <ComboBox ItemsSource="{Binding AssetTypeOptions}"
                        SelectedItem="{Binding AssetTypeFilter, Mode=TwoWay}"
                        Width="100"/>
              <TextBox Text="{Binding AssetSearchText, Mode=TwoWay}" Watermark="search assets"
                       auto:AutomationProperties.AutomationId="AssetSearchBox"
                       Width="160"/>
              <Button x:Name="ImportAssetBtn" Content="Import..." Click="OnImportAsset"
                      auto:AutomationProperties.AutomationId="ImportAssetBtn"/>
              <Button x:Name="RenameAssetBtn" Content="Rename Selected" Click="OnRenameAsset"/>
              <TextBlock Text="{Binding FilteredAssetCount}" VerticalAlignment="Center" Opacity="0.7"
                         auto:AutomationProperties.AutomationId="AssetCountText"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="8,4">
              <Button x:Name="AssignSpriteBtn" Content="Assign Sprite to Selected" Click="OnAssignSprite"/>
              <Button x:Name="AssignScriptBtn" Content="Assign Script to Selected" Click="OnAssignScript"/>
              <Button x:Name="AddMeshToSceneBtn" Content="Add Mesh to Scene" Click="OnAddMeshToScene"
                      auto:AutomationProperties.AutomationId="AddMeshToSceneBtn"
                      IsEnabled="{Binding CanAddSelectedMeshToScene}"/>
              <Button x:Name="InstantiatePrefabBtn" Content="Instantiate Prefab" Click="OnInstantiatePrefab"
                      auto:AutomationProperties.AutomationId="InstantiatePrefabBtn"
                      IsEnabled="{Binding CanInstantiateSelectedPrefab}"/>
              <Button x:Name="ShowDependenciesBtn" Content="Show Dependencies" Click="OnShowDependencies"
                      auto:AutomationProperties.AutomationId="ShowDependenciesBtn"/>
              <Button x:Name="ReimportSourceBtn" Content="Reimport Source" Click="OnReimportSource"
                      auto:AutomationProperties.AutomationId="ReimportSourceBtn"
                      IsEnabled="{Binding CanReimportSelectedMesh}"/>
              <Button x:Name="ReimportDiscardEditsBtn" Content="Reimport (Discard Edits)"
                      Click="OnReimportDiscardEdits"
                      auto:AutomationProperties.AutomationId="ReimportDiscardEditsBtn"
                      IsEnabled="{Binding CanReimportSelectedMesh}"/>
            </StackPanel>
            <ListBox x:Name="DependencyList" Height="64"
                     IsVisible="{Binding IsDependencyViewVisible}"
                     auto:AutomationProperties.AutomationId="DependencyList"
                     ItemsSource="{Binding Dependencies}"
                     DockPanel.Dock="Bottom">
              <ListBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Grid>
              <ListBox x:Name="AssetList"
                       auto:AutomationProperties.AutomationId="AssetList"
                       ItemsSource="{Binding FilteredAssets}"
                       SelectedItem="{Binding SelectedAsset, Mode=TwoWay}"
                       DoubleTapped="OnAssetDoubleTapped">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding TypeName}" Width="64" Opacity="0.7"/>
                      <TextBlock Text="{Binding Name}" Width="120" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Path}" Width="170" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding StatusName}" Width="72" Opacity="0.7"/>
                      <TextBlock Text="{Binding Guid}" FontFamily="Consolas, Courier New"
                                 FontSize="10" Opacity="0.5" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="AssetEmptyState" Text="(no assets)"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsHitTestVisible="False"
                         IsVisible="{Binding !HasAssets}"/>
            </Grid>
          </DockPanel>
          </Border>
        </TabItem>
        <TabItem Header="Script Editor">
          <!-- D1 空态：无选中脚本时显示说明而非空白编辑框 -->
          <Border x:Name="ScriptTabSurface"
                  Background="{DynamicResource PanelSurfaceBrush}">
          <Panel>
            <StackPanel IsVisible="{Binding !HasScriptOpen}" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Spacing="8">
              <TextBlock x:Name="ScriptEmptyTitle" Text="(no script open)" FontWeight="Bold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         HorizontalAlignment="Center" Opacity="0.7"/>
              <TextBlock x:Name="ScriptEmptyHint"
                         Text="Double-click a .lua asset in the Asset Browser to open it."
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Opacity="0.8" HorizontalAlignment="Center"/>
            </StackPanel>
            <DockPanel IsVisible="{Binding HasScriptOpen}">
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                <TextBlock Text="{Binding ScriptTitle}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBlock Text="(edited)" Foreground="{DynamicResource WarningBrush}"
                           IsVisible="{Binding ScriptDirty}" VerticalAlignment="Center"/>
                <Button x:Name="SaveScriptBtn" Content="Save Script" Click="OnSaveScript" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding ScriptError}" Foreground="{DynamicResource ErrorBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380"/>
              </StackPanel>
              <TextBox Text="{Binding ScriptText, Mode=TwoWay}"
                       AcceptsReturn="True" AcceptsTab="True"
                       FontFamily="Consolas, Courier New" FontSize="12"
                       TextChanged="OnScriptTextChanged"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
          </Panel>
          </Border>
        </TabItem>
      </TabControl>

      <!-- P1-A：可拖动分区（不改变各面板的最小尺寸约束） -->
      <GridSplitter x:Name="HierarchySplitter"
                    Grid.Column="1" Grid.RowSpan="3"
                    auto:AutomationProperties.AutomationId="HierarchySplitter"
                    ResizeDirection="Columns"
                    Background="{DynamicResource BorderSubtleBrush}" Opacity="0.2"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
      <GridSplitter x:Name="InspectorSplitter"
                    Grid.Column="3" Grid.Row="0"
                    auto:AutomationProperties.AutomationId="InspectorSplitter"
                    ResizeDirection="Columns"
                    Background="{DynamicResource BorderSubtleBrush}" Opacity="0.2"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
      <GridSplitter x:Name="ConsoleSplitter"
                    Grid.Column="2" Grid.ColumnSpan="3" Grid.Row="1"
                    auto:AutomationProperties.AutomationId="ConsoleSplitter"
                    ResizeDirection="Rows"
                    Background="{DynamicResource BorderSubtleBrush}" Opacity="0.2"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </Grid>
  </DockPanel>
</Window>
